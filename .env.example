# 앱 서버 환경변수. 실제 값은 .env (gitignore 됨) 또는 배포 플랫폼 대시보드에 넣는다.

# 기관 키 시드 (base64url 32바이트). 재시작해도 발급기관 DID 가 같아야
# 폰에 저장된 신분증이 계속 유효하다. 생성:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ISSUER_SEED=
TAX_SEED=

# 온체인 폐기. 셋 다 있어야 체인을 쓰고, 없으면 메모리 스텁으로 동작한다.
REGISTRY_ADDRESS=
RPC_URL=
CHAIN_ID=11155111

# 분실 신고(revoke) 트랜잭션 서명용. 컨트랙트를 배포한 키.
ISSUER_CHAIN_KEY=

# 선택. 기본 3000
# PORT=3000
